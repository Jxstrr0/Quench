{
  "name": "quench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A bladesmithing game. A Longlight Interactive game.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "sim": "node scripts/sim.mjs",
    "cover": "node scripts/cover.mjs",
    "lint": "eslint . && tsc --noEmit",
    "models:check": "node scripts/models-check.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.2.8",
    "@fontsource/space-grotesk": "5.3.0",
    "@fontsource/zilla-slab": "5.2.8",
    "fflate": "0.8.3",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
